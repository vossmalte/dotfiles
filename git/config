[user]
	name = Malte Breitzmann
	email = 22179782+vossmalte@users.noreply.github.com
	signingKey = ~/.ssh/github.pub
[gpg]
  format = ssh
[commit]
	gpgSign = true
[core]
	editor = nvim
[rebase]
	updateRefs = true
[diff]
    tool = kitty
    guitool = kitty.gui
[difftool]
    prompt = false
    trustExitCode = true
[difftool "kitty"]
    cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty.gui"]
    cmd = kitten diff $LOCAL $REMOTE
[includeIf "gitdir:~/repos/work/"]
	# .gitignore'd for privacy reasons
	path = work.toml
